{
  "name": "dicom-lance-viewer",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "React 19 + TypeScript + Cornerstone3D v4 DICOMweb viewer for dicom-lance",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5273 --strictPort",
    "test": "vitest --run",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test -c playwright.live.config.ts"
  },
  "dependencies": {
    "@cornerstonejs/core": "^4.1.0",
    "@cornerstonejs/dicom-image-loader": "^4.1.0",
    "@cornerstonejs/tools": "^4.1.0",
    "dicom-parser": "^1.8.21",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@hegeldev/hegel": "^0.6.1",
    "@originjs/vite-plugin-commonjs": "^1.0.3",
    "@playwright/test": "^1.56.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.7"
  }
}
